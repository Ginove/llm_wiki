# Build LLM Wiki for Ubuntu amd64
# Usage:
#   docker build --platform=linux/amd64 -f Dockerfile.build -t llm-wiki-builder .
#   docker run --rm --platform=linux/amd64 -v "$(pwd)/dist-linux:/out" llm-wiki-builder

FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HTTP_MULTIPLEXING=false
ENV CARGO_NET_RETRY=5
ENV CARGO_HTTP_TIMEOUT=60

# System dependencies (ca-certificates first for SSL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    build-essential \
    pkg-config \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    protobuf-compiler \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (stable)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./
COPY mcp-server/package.json mcp-server/package-lock.json mcp-server/

# Install frontend dependencies
RUN npm install

# Install MCP server dependencies
RUN npm --prefix mcp-server ci

# Copy the rest of the project
COPY . .

# Build MCP server
RUN npm run mcp:build

# Build frontend
RUN npm run build

# Build Tauri app (Linux) — produces .deb + .AppImage
RUN npm run tauri build -- --bundles deb,appimage

# Copy output artifacts
CMD ["bash", "-c", "cp -v src-tauri/target/release/bundle/deb/*.deb /out/ 2>/dev/null; cp -v src-tauri/target/release/bundle/appimage/*.AppImage /out/ 2>/dev/null; echo 'Done.'"]